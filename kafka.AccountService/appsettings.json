{
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "kafka-account-service",
    "Topic": "topic.accounts",
    "DeadLetterTopic": "topic.accounts.dlq"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 500
  },
  "Mongo": {
    "ConnectionString": "mongodb://root:root-password@localhost:27018/?authSource=admin",
    "DatabaseName": "persons"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}